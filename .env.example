# Copy to .env (gitignored) and fill in your project.
GCP_PROJECT=your-project-id
BUCKET_NAME=your-project-id-uploads
BIGQUERY_DATASET=analysis_dataset

# Local only: there is no IAP in front of docker compose, so this stands in for
# the IAP identity. Ignored on Cloud Run (K_SERVICE is set there).
DEV_USER_EMAIL=you@example.com

RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
MAX_UPLOAD_MB=50
LOG_LEVEL=INFO
